# Fill in your API keys below.
# You can leave any key blank — that provider will simply be skipped.

GROQ_API_KEY=your_groq_api_key_here
FIREWORKS_API_KEY=your_fireworks_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Optional: override the model each provider uses
GROQ_MODEL=llama-3.3-70b-versatile
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
GOOGLE_MODEL=gemini-2.5-flash

# Which provider acts as the judge (groq | fireworks | google)
JUDGE_PROVIDER=google

# Admin security — two-part HMAC protection.
# ADMIN_KEY: 32-byte hex secret — store in Doppler (external, outside Render region).
# ADMIN_PASSWORD_HASH: HMAC-SHA256 of your password using the key above.
# Generate both with: python generate_admin_hash.py
ADMIN_KEY=your_32byte_hex_key_here
ADMIN_PASSWORD_HASH=your_hmac_sha256_hash_here
