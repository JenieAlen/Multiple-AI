# Fill in your API keys below.
# You can leave any key blank — that provider will simply be skipped.

GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Ollama — runs locally, no API key needed (install from https://ollama.com)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Optional: override the model each provider uses
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_MODEL=gemini-2.5-flash

# Which provider acts as the judge (groq | ollama | google)
JUDGE_PROVIDER=google

# Password for the admin page at /admin. Leave blank to disable admin entirely.
ADMIN_PASSWORD=your_admin_password_here
